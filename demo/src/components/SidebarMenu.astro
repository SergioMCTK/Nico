---
import { categories } from '../data/categories';
---

<!-- Sidebar overlay -->
<div id="sidebar-overlay" class="fixed inset-0 z-[60] overlay-bg hidden opacity-0 transition-opacity duration-300"></div>

<!-- Sidebar menu -->
<aside
  id="sidebar-menu"
  class="fixed top-0 left-0 h-full w-full md:w-[420px] bg-nico-black z-[70] transform -translate-x-full transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] border-r border-nico-border overflow-y-auto"
>
  <div class="flex flex-col min-h-full px-8 md:px-12 py-8">
    <!-- Close button -->
    <button id="sidebar-close" class="self-end mb-12 group cursor-pointer" aria-label="Close menu">
      <svg class="w-8 h-8 transition-transform duration-300 group-hover:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Navigation links -->
    <nav class="flex-1 flex flex-col gap-2">
      <a href="/" class="sidebar-link font-heading text-5xl md:text-6xl tracking-wide hover:text-nico-red transition-all duration-300 hover:translate-x-4 py-2">
        HOME
      </a>

      <div class="my-4 border-t border-nico-border"></div>
      <span class="text-nico-muted text-xs uppercase tracking-[0.3em] mb-2">By Gender</span>

      {categories.filter(c => c.type === 'gender').map((cat) => (
        <a
          href={`/category/${cat.slug}`}
          class="sidebar-link font-heading text-4xl md:text-5xl tracking-wide hover:text-nico-red transition-all duration-300 hover:translate-x-4 py-1"
        >
          {cat.name}
        </a>
      ))}

      <div class="my-4 border-t border-nico-border"></div>
      <span class="text-nico-muted text-xs uppercase tracking-[0.3em] mb-2">By Category</span>

      {categories.filter(c => c.type === 'clothing').map((cat) => (
        <a
          href={`/category/${cat.slug}`}
          class="sidebar-link font-heading text-3xl md:text-4xl tracking-wide hover:text-nico-red transition-all duration-300 hover:translate-x-4 py-1 text-nico-muted hover:text-nico-red"
        >
          {cat.name}
        </a>
      ))}

      <div class="my-4 border-t border-nico-border"></div>

      <a href="/profile" class="sidebar-link font-heading text-3xl md:text-4xl tracking-wide hover:text-nico-red transition-all duration-300 hover:translate-x-4 py-1 text-nico-muted hover:text-nico-red">
        PROFILE
      </a>
      <a href="/faq" class="sidebar-link font-heading text-3xl md:text-4xl tracking-wide hover:text-nico-red transition-all duration-300 hover:translate-x-4 py-1 text-nico-muted hover:text-nico-red">
        FAQ
      </a>
    </nav>

    <!-- Footer info -->
    <div class="mt-12 pt-6 border-t border-nico-border">
      <p class="text-nico-muted text-sm tracking-wider">&copy; 2026 NICO. ALL RIGHTS RESERVED.</p>
    </div>
  </div>
</aside>

<script>
  const menuToggle = document.getElementById('menu-toggle');
  const sidebarMenu = document.getElementById('sidebar-menu');
  const sidebarOverlay = document.getElementById('sidebar-overlay');
  const sidebarClose = document.getElementById('sidebar-close');

  function openSidebar() {
    sidebarMenu?.classList.remove('-translate-x-full');
    sidebarOverlay?.classList.remove('hidden');
    requestAnimationFrame(() => {
      sidebarOverlay?.classList.remove('opacity-0');
      sidebarOverlay?.classList.add('opacity-100');
    });
    document.body.style.overflow = 'hidden';
  }

  function closeSidebar() {
    sidebarMenu?.classList.add('-translate-x-full');
    sidebarOverlay?.classList.remove('opacity-100');
    sidebarOverlay?.classList.add('opacity-0');
    setTimeout(() => {
      sidebarOverlay?.classList.add('hidden');
    }, 300);
    document.body.style.overflow = '';
  }

  menuToggle?.addEventListener('click', openSidebar);
  sidebarClose?.addEventListener('click', closeSidebar);
  sidebarOverlay?.addEventListener('click', closeSidebar);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeSidebar();
  });
</script>
