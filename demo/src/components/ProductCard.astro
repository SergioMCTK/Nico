---
import type { Product } from '../data/products';

interface Props {
  product: Product;
  index?: number;
}

const { product, index = 0 } = Astro.props;
const delay = index * 80;
---

<a
  href="#"
  class="product-card group block fade-in-element"
  style={`animation-delay: ${delay}ms`}
  data-product-id={product.id}
>
  <div class="relative overflow-hidden product-card-hover">
    <!-- Product image placeholder (gradient) -->
    <div class="glitch-hover relative">
      <div
        class="aspect-[3/4] w-full rounded-sm"
        style={`background: ${product.gradient};`}
      >
        <!-- Product label overlays -->
        <div class="absolute inset-0 flex flex-col justify-between p-4">
          <div class="flex justify-between items-start">
            {product.isNew && (
              <span class="bg-nico-red text-[10px] font-bold uppercase tracking-widest px-3 py-1">
                NEW
              </span>
            )}
            <span class="ml-auto text-[10px] font-bold uppercase tracking-widest text-nico-muted bg-nico-black/60 px-2 py-1">
              {product.gender}
            </span>
          </div>

          <!-- Large product name overlay -->
          <div class="transform translate-y-4 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-500">
            <p class="font-heading text-2xl md:text-3xl leading-none tracking-wide">
              {product.name}
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Product info -->
    <div class="mt-3 space-y-1">
      <div class="flex justify-between items-baseline">
        <h3 class="font-heading text-lg tracking-wider group-hover:text-nico-red transition-colors duration-300">
          {product.name}
        </h3>
        <span class="font-body text-sm font-semibold text-nico-muted group-hover:text-nico-text transition-colors duration-300">
          ${product.price}
        </span>
      </div>
      <p class="text-nico-muted text-xs tracking-wider uppercase">
        {product.category}
      </p>
    </div>

    <!-- Hover border animation -->
    <div class="absolute bottom-0 left-0 w-0 h-[2px] bg-nico-red group-hover:w-full transition-all duration-500"></div>
  </div>
</a>
