---
const lookbookItems = [
  {
    title: "VOID COLLECTION",
    subtitle: "SS26",
    gradient: "linear-gradient(160deg, #0a0a0a 0%, #1a1a2e 30%, #dc2626 100%)",
    span: "md:col-span-2 md:row-span-2",
    height: "h-[400px] md:h-full",
  },
  {
    title: "ECLIPSE",
    subtitle: "BOTTOMS",
    gradient: "linear-gradient(135deg, #0d0221 0%, #3a0ca3 50%, #7c3aed 100%)",
    span: "md:col-span-1",
    height: "h-[300px] md:h-full",
  },
  {
    title: "SHADOW",
    subtitle: "OUTERWEAR",
    gradient: "linear-gradient(180deg, #141414 0%, #1a0010 50%, #6b003d 100%)",
    span: "md:col-span-1",
    height: "h-[300px] md:h-full",
  },
  {
    title: "RAW",
    subtitle: "ESSENTIALS",
    gradient: "linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 50%, #dc2626 100%)",
    span: "md:col-span-2",
    height: "h-[350px]",
  },
  {
    title: "NERVE",
    subtitle: "ACCESSORIES",
    gradient: "linear-gradient(200deg, #0a1a0a 0%, #001a1a 50%, #003d3d 100%)",
    span: "md:col-span-2",
    height: "h-[350px]",
  },
];
---

<section class="py-20 px-6 md:px-10">
  <div class="mb-12 flex items-end justify-between">
    <div>
      <span class="text-nico-muted text-xs uppercase tracking-[0.4em]">Editorial</span>
      <h2 class="font-heading text-5xl md:text-7xl tracking-wider mt-2">LOOKBOOK</h2>
    </div>
    <span class="hidden md:block text-nico-muted text-xs uppercase tracking-[0.3em] writing-vertical">
      Spring / Summer 2026
    </span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-4 gap-3 md:auto-rows-[250px]">
    {lookbookItems.map((item, i) => (
      <div
        class={`relative overflow-hidden group cursor-pointer ${item.span} ${item.height} fade-in-element`}
        style={`animation-delay: ${i * 120}ms`}
      >
        <div
          class="absolute inset-0 transition-transform duration-700 ease-out group-hover:scale-110"
          style={`background: ${item.gradient};`}
        ></div>

        <!-- Content overlay -->
        <div class="absolute inset-0 flex flex-col justify-end p-6 md:p-8">
          <div class="transform translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
            <span class="text-nico-muted text-[10px] uppercase tracking-[0.3em]">{item.subtitle}</span>
            <h3 class="font-heading text-3xl md:text-4xl tracking-wider mt-1">{item.title}</h3>
          </div>

          <!-- Hover line -->
          <div class="mt-4 w-0 group-hover:w-16 h-[2px] bg-nico-red transition-all duration-500"></div>
        </div>

        <!-- Corner accent -->
        <div class="absolute top-4 right-4 w-8 h-8 border-t-2 border-r-2 border-nico-text/20 group-hover:border-nico-red transition-colors duration-500"></div>
      </div>
    ))}
  </div>
</section>
